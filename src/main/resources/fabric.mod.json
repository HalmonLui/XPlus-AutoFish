{
  "schemaVersion": 1,
  "id": "autofish",
  "version": "${version}",
  "name": "Noms Autofisher",
  "description": "Automatically reels in and recasts your fishing rod when you catch a fish. Now for 1.19.4+.",
  "authors": [
    "Nom"
  ],
  "contributors": [
    "linganguliguli"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/x-autofish",
    "sources": "https://github.com/Wudji/XPlus-AutoFish"
  },

  "icon": "assets/autofish/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "troy.autofish.FabricModAutofish"
    ],
    "modmenu": [
      "troy.autofish.modmenu.ModMenuApiAutofish"
    ]
  },
  "mixins": [
    "autofish.mixins.json"
  ],

  "depends": {
    "fabric": "*",
    "cloth-config": "*"
  }
}
